flowchart TB
    %% ===================== External actors and systems =====================
    subgraph EXT["External actors and systems"]
        direction LR
        FarmerPhone["Farmer\n(USSD / feature phone)"]
        WebUser["Farmer, Vendor, Verified Buyer,\nExtension Officer, System Admin\n(web browser)"]
        USSDGW["USSD Gateway\n(mocked / simulated — Proposal SS5)"]
    end

    FarmerPhone --> USSDGW

    %% ===================== Channel adapter layer =====================
    subgraph ADAPT["Channel Adapters (no business logic)"]
        direction LR
        USSDAdapter["USSD Adapter\nmenu flow, session state"]
        WebAdapter["Web / REST API Adapter\nHTTP request handling"]
    end

    USSDGW -->|"USSD session"| USSDAdapter
    WebUser -->|"HTTPS"| WebAdapter

    %% ===================== Application / domain layer =====================
    subgraph APP["Application and Domain Layer"]
        direction TB

        subgraph SVC["Application services (implement channel-agnostic interfaces)"]
            direction LR
            FPCSvc["FairPriceCheckService\nimplements ICheckFairPrice"]
            SubSvc["PriceSubmissionService\nimplements ISubmitPriceEntry"]
            TrendSvc["TrendLookupService\nimplements ITrendLookup"]
            AdminSvc["AdminService\nimplements IAdminActions"]
        end

        subgraph DOMAIN["Domain model (crc-cards.md)"]
            direction LR
            PriceEntryC["PriceEntry"]
            PriceBucketC["PriceBucket"]
            ResultC["FairPriceCheckResult"]
            ConvC["ConversionFactorTable"]
            ConfigC["SystemConfiguration"]
            AuditC["AuditLogRecord"]
        end

        Worker["AggregateRecomputeWorker\n(in-process, triggered on\nPriceEntry -> Verified)"]
    end

    USSDAdapter -->|"ICheckFairPrice /\nISubmitPriceEntry / ITrendLookup"| FPCSvc
    USSDAdapter --> SubSvc
    USSDAdapter --> TrendSvc
    WebAdapter --> FPCSvc
    WebAdapter --> SubSvc
    WebAdapter --> TrendSvc
    WebAdapter -->|"IAdminActions\n(authenticated Admin role only)"| AdminSvc

    FPCSvc --> PriceBucketC
    FPCSvc --> ResultC
    FPCSvc --> ConfigC
    SubSvc --> PriceEntryC
    SubSvc --> ConvC
    TrendSvc --> PriceBucketC
    AdminSvc --> AuditC
    AdminSvc --> ConfigC
    AdminSvc --> PriceEntryC

    PriceEntryC -.->|"raises PriceEntryVerified\n(BR-02 condition met)"| Worker
    Worker --> PriceBucketC
    Worker --> AuditC

    %% ===================== Data layer =====================
    subgraph DATA["Data Layer (single relational database)"]
        direction LR
        DB_Entries[("PriceEntry table")]
        DB_Aggregates[("BucketAggregate table\n(cached median, confidence,\ncomputed-at timestamp)")]
        DB_Audit[("AuditLogRecord table\n(append-only)")]
        DB_Config[("SystemConfiguration table")]
    end

    PriceEntryC --> DB_Entries
    PriceBucketC -->|"read (fast path)"| DB_Aggregates
    Worker -->|"write"| DB_Aggregates
    AuditC --> DB_Audit
    ConfigC --> DB_Config

    %% ===================== Boundary annotations =====================
    subgraph NOTES["Architectural boundaries"]
        direction LR
        BoundaryNote1["Trust boundary: adapters validate/translate\ninput only — no business rules cross this line"]
        BoundaryNote2["Security boundary: only AdminService may\nwrite AuditLogRecord or SystemConfiguration"]
        BoundaryNote3["Failure boundary: if Worker fails or lags,\nBucketAggregate goes stale but reads still\nsucceed — graceful degradation, not an outage"]
    end

    DATA ~~~ NOTES

